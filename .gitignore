# Node modules
node_modules/
client/node_modules/
server/node_modules/

# Vite / React build
dist/
client/dist/

# React old build folder
build/

# Environment variables
.env
client/.env
server/.env
# Real production/local envs (the *.example templates stay committable).
.env.production
.env.production.local
.env.*.local
server/.env.production
server/.env.production.local
# Exception: the client's production build config is safe to commit because
# every VITE_ value is inlined into the browser bundle and is public anyway.
# *.local overrides stay ignored.
!client/.env.production

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (for OCR scripts if used)
__pycache__/
*.pyc

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/