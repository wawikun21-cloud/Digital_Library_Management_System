# Default Admin (optional, for first-time setup only)
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=your-secure-password

# ── Email (Gmail + App Password) ──────────────────────────
# Steps to get an App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (required)
#   3. Search "App Passwords" → select "Mail" → generate
#   4. Paste the 16-character password below (no spaces)
# GMAIL_USER=your-gmail@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password

# Run schema migrations on startup (true / false)
RUN_MIGRATIONS=false
# Display name shown in the "From:" field of every email
EMAIL_FROM_NAME=Digital Library

# ── RFID Kiosk IP Whitelist (optional) ─────────────────────
# Comma-separated list of allowed IPs for RFID tap endpoint
# RFID_ALLOWED_IPS=192.168.1.100,10.0.0.5
