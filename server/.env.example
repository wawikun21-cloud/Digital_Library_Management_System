# ── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lexora
# Production hosting providers normally require the database to be created
# in their control panel. Keep this false in production unless the DB user
# explicitly has CREATE DATABASE privileges.
DB_CREATE_DATABASE=true

# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=your-long-random-secret-here
# Optional absolute path to persistent uploads storage. Use a directory outside
# deployment/release folders in production.
# UPLOADS_DIR=/home/your-user/private/lexora-uploads

# ── Default Admin (optional, for first-time setup only) ───────
# If not set, in development a Super Admin + test users are seeded
# with the password below. In production, you MUST set these.
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=your-secure-password
#
# Dev seed users (username / password):
#   superadmin / password123
#   admin      / password123
#   librarian  / password123
#   staff      / password123
#   student    / password123

# ── RFID Kiosk IP Whitelist (optional) ─────────────────────────
# Comma-separated list of allowed IPs for RFID tap endpoint
# If empty in production, all IPs are allowed (rate-limited only)
# RFID_ALLOWED_IPS=192.168.1.100,10.0.0.5

# ── App branding (used in emails) ─────────────────────────────
APP_NAME=Digital Library

# ── Email (Gmail + App Password) ──────────────────────────
# Steps to get an App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (required)
#   3. Search "App Passwords" → select "Mail" → generate
#   4. Paste the 16-character password below (no spaces)

GMAIL_USER=
GMAIL_APP_PASSWORD=

# Run schema migrations on startup (true / false). Back up production data
# before enabling migrations during an upgrade.
RUN_MIGRATIONS=true

# Display name shown in the "From:" field of every email
EMAIL_FROM_NAME=Digital Library
