# ─────────────────────────────────────────────────────────
#  server/.env.production.example
#
#  Hostinger MONOLITHIC deployment — the Express server serves the built
#  React client, the API, uploaded media, and Socket.IO from one Node
#  process on one domain.
#
#  HOW TO USE THIS FILE
#  -------------------
#  On Hostinger these variables are configured as application environment
#  variables in hPanel, NOT shipped as a file. This file is:
#    • a checklist of everything the production app reads
#    • a template you can copy to server/.env.production for a local
#      production-mode rehearsal (that file is gitignored)
#
#  Do not commit a real production .env. Do not reuse the SESSION_SECRET
#  that is currently committed in server/.env — see the last section.
#
#  Only .env.production (server/.env.production) is auto-loaded by dotenv in
#  production mode (see server/config/loadEnv.js). A production-mode
#  rehearsal needs:
#  `cp server/.env.production.example server/.env.production`
#  (that file is gitignored).
# ─────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────
# Must be production: switches on secure cookies, the env validation
# gate in config/env.js, and stricter rate limits.
NODE_ENV=production

# Assigned by Hostinger to the Node application. Do NOT hard-code a public
# port and do not expose 3001 in any URL — the domain's reverse proxy routes
# HTTP and WebSocket traffic to this port.
# Leave unset locally; the app falls back to 3001.
PORT=

# ── Public origin ────────────────────────────────────────
# The exact public origin users type, with scheme, no trailing slash.
# Used for CORS, Socket.IO origin checks, and links inside emails.
# CLIENT_URL and APP_URL are accepted as fallbacks; set CLIENT_ORIGIN.
CLIENT_ORIGIN=https://library.example.com

# ── Session ──────────────────────────────────────────────
# Required. Signs the login session cookie.
# Generate a fresh secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NOTE: rotating this logs everyone out once.
SESSION_SECRET=

# ── MySQL (provisioned in hPanel before deploying) ───────
# The production app connects to an existing database and does not create
# one. Creating the database and granting the user (including the DDL
# rights needed for schema setup) happens in hPanel.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=lexora

# false: never let the app create or select into a database it does not own.
# Only set true if the DB user genuinely has CREATE DATABASE privileges.
DB_CREATE_DATABASE=false

# ── Schema migrations ────────────────────────────────────
# true  → apply the schema/migrations on startup (use for the first deploy
#         and for a planned upgrade)
# false → skip them, because they were applied separately
# Back up the database BEFORE deploying any schema change.
RUN_MIGRATIONS=true

# ── Upload storage ───────────────────────────────────────
# REQUIRED for real use. Must be an absolute path on writable storage that
# survives redeploys and restarts. Do NOT point this at client/dist, a temp
# directory, or a deploy release folder — uploads there are lost on redeploy.
# Typical Hostinger shape: /home/<user>/private/lexora-uploads
# Legacy files under server/uploads keep being served as a fallback.
UPLOADS_DIR=

# ── First-run admin (optional, first install only) ───────
# Seeded only when the users table is empty. Leave unset after the first
# successful deploy, and delete the pair once you have created a real
# administrator, so they cannot be re-seeded later.
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=

# ── Email (optional) ─────────────────────────────────────
# Both must be set to enable email; leave both unset and the server logs
# that email is disabled and carries on.
# App Password is 16 characters with no spaces (see .env.example).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Display name in the From: field. APP_NAME is used as the fallback.
EMAIL_FROM_NAME=Digital Library
APP_NAME=Digital Library

# ── RFID kiosk IP whitelist (optional) ───────────────────
# Comma-separated IPs allowed to use the RFID tap endpoint.
# Empty in production means all IPs (rate-limited only).
RFID_ALLOWED_IPS=

# ── Redis (optional) ─────────────────────────────────────
# Optional accelerator. Left unset, cacheService falls back to an in-memory
# node-cache and logs a warning, which is fine for a single Node process.
# No Redis is required for this deployment.
# REDIS_HOST=
# REDIS_PORT=6379

# ─────────────────────────────────────────────────────────
#  SECURITY — rotate before going live
# ─────────────────────────────────────────────────────────
#  server/.env is COMMITTED to git (gitignore does not apply to files that
#  were tracked before the rule was added) and contains a real
#  SESSION_SECRET plus local database settings. It is harmless only because
#  it is dev-only, but:
#
#    1. Never reuse that SESSION_SECRET in production — generate a new one
#       above. Anyone with the repository has the committed value.
#    2. Untrack the file so future edits stop leaking:
#         git rm --cached server/.env
#       then commit. The working copy stays on disk untouched.
#    3. hPanel environment variables take precedence over dotenv, which
#       never overrides an already-set process.env value, so a stray
#       .env on the server does not shadow them — but deleting it removes
#       the confusion entirely.
# ─────────────────────────────────────────────────────────
