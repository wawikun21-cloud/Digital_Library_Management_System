# Frontend environment variables (Vite)
# Prefix all variables with VITE_ to expose them to the browser bundle.
# This file is safe to commit — it contains NO secrets.

# Leave empty for the single-domain deployment. The app then uses relative
# /api URLs, and the Vite development proxy forwards them to port 3001.
# If using a separate API origin for another deployment, set its API base URL,
# including /api (for example https://api.example.com/api).
VITE_API_URL=

# Feature Flags (set to 'true' or 'false')
VITE_ENABLE_BARCODE_SCANNER=true
VITE_ENABLE_BOOK_LOOKUP=true
VITE_ENABLE_EDITIONS=true
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_ANIMATIONS=true
